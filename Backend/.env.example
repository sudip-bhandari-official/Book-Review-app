# -------------------------------------------------------------
# BookNest Backend — environment variables
# Copy to .env for local dev, or set in your host's dashboard
# (Render / Railway / Heroku → "Environment Variables").
# -------------------------------------------------------------

# MongoDB connection string. Use MongoDB Atlas for production:
#   mongodb+srv://<user>:<password>@cluster0.mongodb.net/booknest?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/booknest

# Port the Express server listens on. Render/Heroku set this automatically.
PORT=5000

# Secret used to sign JWTs — pick a long random string in production!
JWT_SECRET=replace-with-a-long-random-string

# Secret used by the /auth/backdoor-admin route (for bootstrapping an admin).
# Remove or change this before going live.
ADMIN_SECRET_KEY=change-me-in-prod

# Comma-separated list of frontend origins allowed to call the API.
# Add your Vercel production URL here once deployed, e.g.:
#   https://booknest.vercel.app,https://booknest-git-dev-you.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
